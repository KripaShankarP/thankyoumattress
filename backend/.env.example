PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/thankyoumattress?schema=public"
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
REVALIDATE_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=./uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME="Store Owner"

# Customer sign-in with OTP
OTP_SECRET=change-me-to-64-random-hex-characters-openssl-rand-hex-32
# console = print codes in the terminal (development only); msg91 or fast2sms to send real SMS
SMS_PROVIDER=console
# MSG91: auth key + an OTP template (DLT approved) whose variable is the code
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Fast2SMS: API key (uses the OTP route)
FAST2SMS_API_KEY=

# Sign-in codes by email: log = print them in this terminal (development only); smtp to send real email
MAIL_TRANSPORT=log
# Gmail: smtps://you%40gmail.com:APP-PASSWORD@smtp.gmail.com:465 (an App Password, not your normal password)
SMTP_URL=
MAIL_FROM="Thankyou Mattresses <no-reply@thankyoumattresses.com>"
